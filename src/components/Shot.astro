---
interface Props { src: string; alt: string; priority?: boolean }
const { src, alt, priority = false } = Astro.props;
---
<figure class="overflow-hidden rounded-xl border border-line-bright bg-panel shadow-[0_20px_60px_-30px_rgb(var(--text)/0.35)]">
  <div aria-hidden="true" class="flex items-center gap-1.5 border-b border-line bg-panel-2 px-3 py-2">
    <span class="h-2.5 w-2.5 rounded-full bg-bad/80"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-warn/80"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-ok/80"></span>
  </div>
  <img src={`/shots/${src}`} alt={alt} width="1440" height="900"
       loading={priority ? "eager" : "lazy"} decoding="async" fetchpriority={priority ? "high" : "auto"}
       class="block h-auto w-full" />
</figure>
