---
interface Props { size?: number; wordmark?: boolean }
const { size = 28, wordmark = true } = Astro.props;
---
<span class="inline-flex items-center gap-2">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <ellipse cx="16" cy="21" rx="8" ry="6.5" fill="rgb(var(--accent))"/>
    <circle cx="8" cy="12" r="3.2" fill="rgb(var(--accent))"/>
    <circle cx="13.5" cy="8" r="3.2" fill="rgb(var(--accent))"/>
    <circle cx="19.5" cy="8" r="3.2" fill="rgb(var(--accent))"/>
    <circle cx="25" cy="12" r="3.2" fill="rgb(var(--accent))"/>
  </svg>
  {wordmark && <span class="font-semibold tracking-tight text-text-strong">KonaClaw</span>}
</span>
