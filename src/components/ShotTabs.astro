---
import { getImage } from "astro:assets";
interface Pane { src: string; alt: string; label: string }
interface Props { shots: Pane[] }
const { shots } = Astro.props;
const glob = import.meta.glob<{ default: ImageMetadata }>("/src/assets/shots/*.png", { eager: true });

const SIZES = "(min-width: 1152px) 896px, (min-width: 768px) 92vw, 100vw";
const cfgs = [];
for (const s of shots) {
  const entry = glob[`/src/assets/shots/${s.src}`];
  if (!entry) throw new Error(`ShotTabs: no screenshot named "${s.src}"`);
  const narrow = await getImage({ src: entry.default, width: 720, format: "webp", quality: "high" });
  const wide = await getImage({ src: entry.default, width: 1440, format: "webp", quality: "high" });
  cfgs.push({
    src: wide.src,
    srcset: wide.srcSet?.attribute || `${narrow.src} 720w, ${wide.src} 1440w`,
    sizes: SIZES,
    width: wide.attributes?.width,
    height: wide.attributes?.height,
    alt: s.alt,
  });
}
const first = cfgs[0];
// Panes 1..n ride along as JSON; site.js swaps them into the <img> on
// demand, so the homepage ships exactly one image instead of four.
const rest = JSON.stringify(cfgs.slice(1));
---
<div class="shot-stack" data-stack data-interval="5200" data-shots={rest}>
  <div role="tablist" aria-label="Screenshots" class="relative z-10 -mb-px flex flex-wrap justify-center gap-1 px-2">
    {shots.map((s, i) => (
      <button type="button" role="tab" id={`shot-tab-${i}`} aria-controls="shot-panel"
              aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}
              class="shot-tab">{s.label}</button>
    ))}
  </div>
  <div class="shot-stage shot-spot" data-tilt>
    {/* One mounted <img>, swapped src by site.js. No-JS: this pane simply
        shows the first screenshot — nothing hidden, nothing to click. */}
    <div role="tabpanel" id="shot-panel" aria-labelledby="shot-tab-0"
         class="shot-frame overflow-hidden rounded-xl border border-line-bright bg-panel shadow-[0_28px_80px_-32px_rgb(var(--text)/0.45)]">
      <div aria-hidden="true" class="flex items-center gap-1.5 border-b border-line bg-panel-2 px-3 py-2">
        <span class="h-2.5 w-2.5 rounded-full bg-bad/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-warn/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-ok/80"></span>
      </div>
      <img data-shot-img src={first.src} alt={first.alt} width={first.width} height={first.height}
           srcset={first.srcset} sizes={first.sizes} decoding="async" fetchpriority="high"
           class="block h-auto w-full" />
      <span aria-hidden="true" class="shot-sheen"></span>
    </div>
  </div>
</div>
