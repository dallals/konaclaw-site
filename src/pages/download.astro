    <p class="mt-4 text-sm text-muted-aa"><strong>Reading the table:</strong> the base model is Qwen&nbsp;27B at 4-bit MLX quantization (~15&nbsp;GB of weights + ~1.3&nbsp;GB of KV cache per 4&thinsp;K tokens of context). Generation speed is <em>bandwidth&nbsp;&divide;&nbsp;15&nbsp;GB</em> in the limit, which is why an M1&nbsp;Max outruns a new base&nbsp;M4 and why &ldquo;2023 laptop&rdquo; tells you nothing on its own. Prefill is compute-bound &mdash; the M1&rsquo;s original GPU shuffles a 32&thinsp;K-token document in about 4 minutes where an M4&nbsp;Max needs ~40&nbsp;seconds. <strong>M1 owners:</strong> at 16&nbsp;GB the 27B genuinely does not fit &mdash; and at 8&nbsp;GB nothing bigger than 7B does. KonaClaw offers you Qwen3&nbsp;8B instead, which runs respectably. <strong>M5&nbsp;Pro, M5&nbsp;Ultra and M6 are projections</strong> from public analyst forecasts and architectural trends, marked <span class="proj-tag">est</span> &mdash; we will publish measured numbers the week each machine ships, measured by KonaClaw&rsquo;s first-launch benchmark on your exact silicon.</p>
  </section>
</Base>

<script>
  // Qwen27B-4bit: ~15 GB weights, ~1.3 GB KV cache per 4K tokens (GQA).
  // Generation tok/s = bandwidth-bound: 15 / (15 + KV). KV grows linearly.
  // Prefill tok/s = compute-bound, but attention cost per token grows
  // linearly with position, so effective throughput ~ base / (1 + 0.007·ctxK).
  const WEIGHTS = 15, KV_PER_4K = 1.3, OVERHEAD = 2, ATT_K = 0.007;

  const fmt = (n: number): string => {
    if (n >= 1000) return Math.round(n).toLocaleString("en-US");
    if (n >= 10) return String(Math.round(n));
    return (Math.round(n * 10) / 10).toFixed(1);
  };

  const rows = [...document.querySelectorAll<HTMLTableRowElement>(
    "table.chip-table tbody tr[data-gen]")];

  function apply(ctxK: number) {
    const kv = KV_PER_4K * (ctxK / 4);
    const need = WEIGHTS + kv + OVERHEAD;
    // Normalized at 4K so the default view matches the static table exactly.
    const genF = (WEIGHTS / (WEIGHTS + kv)) / (WEIGHTS / (WEIGHTS + KV_PER_4K));
    const preF = (1 / (1 + ATT_K * ctxK)) / (1 / (1 + ATT_K * 4));
    let maxGen = 0;
    for (const tr of rows) maxGen = Math.max(maxGen, hi(parse(tr.dataset.gen!)) * genF);

    for (const tr of rows) {
      const [gLo, gHi] = parse(tr.dataset.gen!).map(v => v * genF);
      const [pLo, pHi] = parse(tr.dataset.prefill!).map(v => v * preF);
      const mem = Number(tr.dataset.mem!);

      const bar = tr.querySelector<HTMLElement>(".speed .bar i");
      const num = tr.querySelector<HTMLElement>(".speed .num");
      if (bar && num) {
        bar.style.width = Math.max(2, Math.round((gHi / maxGen) * 100)) + "%";
        num.innerHTML = range(gLo, gHi) + " <small>tk/s</small>";
      }
      const pf = tr.querySelector<HTMLElement>(".prefill");
      if (pf && pf.firstChild && pf.firstChild.nodeType === Node.TEXT_NODE) {
        pf.firstChild.textContent = "~" + range(pLo, pHi) + "\u00a0tk/s";
      }

      const fit = tr.querySelector<HTMLElement>(".fit");
      if (fit) {
        if (need <= mem) {
          fit.className = "fit yes";
          fit.textContent = "Yes";
          tr.classList.remove("no-fit");
        } else if (need <= mem * 1.15) {
          fit.className = "fit tight";
          fit.textContent = mem + "\u00a0GB swap";
          tr.classList.remove("no-fit");
        } else {
          fit.className = "fit no";
          fit.textContent = "No \u00b7 needs " + fmt(need) + "\u00a0GB";
          tr.classList.add("no-fit");
        }
      }
    }

    for (const s of document.querySelectorAll<HTMLElement>(".ctx-head")) {
      s.textContent = ctxLabel(ctxK);
    }
    const note = document.querySelector<HTMLElement>(".ctx-note");
    if (note) {
      const kvTxt = kv >= 1 ? fmt(kv) + "\u00a0GB" : Math.round(kv * 1000) + "\u00a0MB";
      note.textContent = "At " + ctxLabel(ctxK) + " the KV cache adds " + kvTxt
        + " on top of the ~15\u00a0GB of weights \u2014 total ~" + fmt(need)
        + "\u00a0GB. Generation slows by ~" + Math.round((1 - genF) * 100)
        + "% and prefill by ~" + Math.round((1 - preF) * 100)
        + "% versus a 4\u00a0K chat.";
      note.hidden = ctxK === 4;
    }
  }

  function parse(v: string): [number, number] {
    const p = v.split("-").map(Number);
    return [p[0], p.length > 1 ? p[1] : p[0]];
  }
  const hi = (p: [number, number]) => p[1];
  const range = (lo: number, gHi: number) =>
    lo === gHi ? "~" + fmt(lo) : "~" + fmt(lo) + "\u2013" + fmt(gHi);
  const ctxLabel = (k: number) =>
    k >= 1000 ? (k / 1000) + "\u00a0M" : k + "\u00a0K";

  for (const btn of document.querySelectorAll<HTMLButtonElement>(".ctx-btn")) {
    btn.addEventListener("click", () => {
      for (const b of document.querySelectorAll<HTMLButtonElement>(".ctx-btn")) {
        b.classList.toggle("is-active", b === btn);
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      }
      apply(Number(btn.dataset.ctx));
    });
  }
</script>
