---
import Base from "../layouts/Base.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import {
  CHIPS, CONTEXTS, MODEL, WEIGHTS,
  genRange, prefillRange, fitFor, maxGen,
  range, ctxLabel, memLabel, bwLabel,
} from "../lib/chips";

const DEFAULT_CTX = 4;
const top = maxGen(DEFAULT_CTX);

// One pass over the chips, grouped by family, rendered from the same module the
// client script re-runs on every context change. Static markup and the picker
// cannot drift apart because neither one hand-writes a number.
const families: { title: string; chips: typeof CHIPS }[] = [];
for (const c of CHIPS) {
  const last = families[families.length - 1];
  if (last && last.title === c.family) last.chips.push(c);
  else families.push({ title: c.family, chips: [c] });
}
---
<Base title="Download" description="KonaClaw for macOS on Apple silicon. Free trial at launch, then a paid license. Leave an email to be told when it ships.">
  <section class="pt-16">
    <h1 class="text-4xl font-semibold tracking-tight text-text-strong">Get KonaClaw</h1>
    <p class="mt-4 max-w-prose text-lg text-text">The first release is being signed and notarized now. Leave an email and you will get exactly one message the day it is live.</p>
    <div class="mt-8"><WaitlistForm /></div>
  </section>

  <section class="prose-kc mt-16 grid gap-10 md:grid-cols-2">
    <div>
      <h2>How it will work</h2>
      <p>Download a disk image, drag KonaClaw to Applications, open it. A short setup asks for the permissions you want to grant and downloads a model sized to your Mac. First chat in a few minutes.</p>
      <p><strong>Free trial, then a paid license.</strong> Try everything first. Pricing is announced at launch.</p>
    </div>
    <div>
      <h2>Requirements</h2>
      <ul>
        <li>A Mac with Apple silicon (M1 or later).</li>
        <li>macOS 14 (Sonoma) or later.</li>
        <li>16 GB of memory or more. The larger models want 32 GB or more.</li>
        <li>About 10 GB of disk for the app and a first model.</li>
      </ul>
      <p>The rule of thumb: a 4-bit model needs roughly 0.6&nbsp;GB per billion parameters, plus room for macOS and your apps. KonaClaw checks your Mac at first launch and never downloads a model that doesn't fit comfortably.</p>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-semibold tracking-tight text-text-strong">A model sized to your Mac</h2>
    <p class="mt-3 max-w-prose text-text">Setup picks the sweet-spot model for your machine automatically, and you can switch any time in Settings. Speeds below are derived from each chip's memory bandwidth, not measured on every machine &mdash; see the note under the next table for the method.</p>
    <div class="mt-6 overflow-x-auto">
      <table class="spec-table">
        <thead>
          <tr>
            <th scope="col">Your Mac</th>
            <th scope="col">Recommended MLX models</th>
            <th scope="col">Approx. speed</th>
            <th scope="col">What it feels like</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" class="whitespace-nowrap">M1 · 16 GB<br class="hidden sm:block"><span class="text-muted-aa text-sm font-normal">(Air, mini, MBP)</span></th>
            <td>Qwen3&nbsp;8B · Llama&nbsp;3.1&nbsp;8B</td>
            <td class="whitespace-nowrap">~10–12 tok/s</td>
            <td>Comfortable chat, drafts and mail triage. Stick to 8B and close the 40-tab browser window.</td>
          </tr>
          <tr>
            <th scope="row" class="whitespace-nowrap">M1 Pro / Max · M2 · M3<br><span class="text-muted-aa text-sm font-normal">16–32 GB</span></th>
            <td>Qwen3&nbsp;14B · gpt-oss-20b<br><span class="text-muted-aa text-sm">24B if you have 32&nbsp;GB</span></td>
            <td class="whitespace-nowrap">~10–35 tok/s</td>
            <td>The capable middle of the road. 32&nbsp;GB unlocks Mistral&nbsp;Small&nbsp;24B and its much better tool use.</td>
          </tr>
          <tr>
            <th scope="row" class="whitespace-nowrap">M4 · M5<br><span class="text-muted-aa text-sm font-normal">24–32 GB</span></th>
            <td>Mistral&nbsp;Small&nbsp;24B<br><span class="text-muted-aa text-sm">or Qwen3-30B-A3B</span></td>
            <td class="whitespace-nowrap">~7–9 tok/s dense<br><span class="text-muted-aa text-sm">~50–64 at 30B-A3B</span></td>
            <td>The sparse MoE only activates ~3B parameters per token, so it answers several times faster than the dense 24B beside it.</td>
          </tr>
          <tr>
            <th scope="row" class="whitespace-nowrap">M4 Pro / Max · M5 Pro / Max<br><span class="text-muted-aa text-sm font-normal">48–128 GB</span></th>
            <td>Qwen3&nbsp;32B · gpt-oss-120b<br><span class="text-muted-aa text-sm">120B wants 96&nbsp;GB+</span></td>
            <td class="whitespace-nowrap">~12–27 tok/s at 32B</td>
            <td>Frontier-class quality, still local. gpt-oss-120b is the best model that fits a desk Mac today.</td>
          </tr>
          <tr>
            <th scope="row" class="whitespace-nowrap">Studio / Ultra · M3 Ultra and later<br><span class="text-muted-aa text-sm font-normal">96–512 GB</span></th>
            <td>Llama&nbsp;3.3&nbsp;70B · gpt-oss-120b · bigger still</td>
            <td class="whitespace-nowrap">~16–24 tok/s at 70B</td>
            <td>Server-class models on your desk, quietly. Everything the catalog offers, at full size.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-semibold tracking-tight text-text-strong">{MODEL} at 4-bit: M1 through M6</h2>
    <p class="mt-3 max-w-prose text-text">One model, every generation of Apple silicon. Generation speed is memory-bandwidth-bound, so the bars track the pipe, not the launch year &mdash; which is why an M1&nbsp;Max still outruns a new base&nbsp;M4. Prefill (reading your prompt, documents and code) is compute-bound and shown separately; it is the column old Macs lose hardest. Pick a context window below: the cache grows on top of the ~{WEIGHTS}&nbsp;GB of weights, which slows generation and raises the memory the model needs to fit.</p>

    <div class="mt-6 ctx-picker" role="group" aria-label="Context size">
      <span class="ctx-label">Context window</span>
      <div class="ctx-options">
        {CONTEXTS.map((k) => (
          <button type="button" class:list={["ctx-btn", { "is-active": k === DEFAULT_CTX }]}
                  data-ctx={String(k)} aria-pressed={k === DEFAULT_CTX ? "true" : "false"}>
            {ctxLabel(k).replace(" ", " ")}
          </button>
        ))}
      </div>
    </div>
    <p class="ctx-note" hidden></p>

    <div class="mt-4 overflow-x-auto">
      <table class="chip-table">
        <thead>
          <tr>
            <th scope="col">Chip</th>
            <th scope="col">CPU&nbsp;·&nbsp;GPU</th>
            <th scope="col">Memory options</th>
            <th scope="col">Bandwidth</th>
            <th scope="col">Prefill&nbsp;@&nbsp;<span class="ctx-head">{ctxLabel(DEFAULT_CTX)}</span></th>
            <th scope="col">Generation&nbsp;·&nbsp;tok/s&nbsp;@&nbsp;<span class="ctx-head">{ctxLabel(DEFAULT_CTX)}</span></th>
            <th scope="col">Fits&nbsp;@&nbsp;<span class="ctx-head">{ctxLabel(DEFAULT_CTX)}</span>?</th>
          </tr>
        </thead>
        <tbody>
          {families.map((f) => (
            <>
              <tr class="family"><th scope="colgroup" colspan="7">{f.title}</th></tr>
              {f.chips.map((c) => {
                const gen = genRange(c, DEFAULT_CTX);
                const fit = fitFor(c, DEFAULT_CTX);
                return (
                  <tr class:list={[{ "no-fit": fit.level === "no" }]} data-chip={c.name}>
                    <th scope="row">{c.name}<span class="chip-meta">{c.where}</span></th>
                    <td>{c.cpu}&nbsp;·&nbsp;{c.gpu}</td>
                    <td>{memLabel(c.mem)}</td>
                    <td>{bwLabel(c.bw)}</td>
                    <td class="prefill"><span class="pf-num">{range(prefillRange(c, DEFAULT_CTX))}&nbsp;tk/s</span>{c.ppEst && <abbr class="est" title="Interpolated from sibling chips: this one has no measured row in the source benchmark">est</abbr>}</td>
                    <td>
                      <span class="speed">
                        <span class="bar"><i style={`width:${Math.max(2, Math.round((gen[1] / top) * 100))}%`}></i></span>
                        <span class="num">{range(gen)} <small>tk/s</small></span>
                      </span>
                    </td>
                    <td><span class:list={["fit", fit.level]}>{fit.label}</span></td>
                  </tr>
                );
              })}
            </>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-sm text-muted-aa"><strong>Where these numbers come from.</strong> Core counts, memory options and bandwidth are Apple's published specifications. The rest is derived, and here is exactly how. {MODEL} is a hybrid: only 16 of its 64 layers carry a growing KV cache (the other 48 are Gated&nbsp;DeltaNet, which keeps a fixed-size state), so it costs ~64&nbsp;KB per token &mdash; about a quarter of a conventional model this size, and the reason long context is affordable here at all. <strong>Generation</strong> is <em>bandwidth&nbsp;&times;&nbsp;0.8&nbsp;&divide;&nbsp;(weights&nbsp;+&nbsp;cache)</em>; the 0.8 is what MLX reaches against peak, anchored on the one public measurement we could find &mdash; a 32&nbsp;GB M4 Mac&nbsp;mini at 5&ndash;6&nbsp;tok/s. <strong>Prefill</strong> starts from measured <a href="https://github.com/ggml-org/llama.cpp/discussions/4167" rel="nofollow noopener">llama-bench pp512 figures for LLaMA&nbsp;7B</a> on each chip, rescaled by 7/27 &mdash; treat it as a floor: those runs mix quantizations and use llama.cpp rather than MLX, which prefills faster. Three chips (M5, M5&nbsp;Ultra, M6) have no row in that thread and are interpolated from their siblings, marked <abbr class="est">est</abbr>. <strong>M1 and M2 owners:</strong> a 27B does not fit in 16&nbsp;GB, and at 8&nbsp;GB nothing past 7B does &mdash; KonaClaw offers you Qwen3&nbsp;8B instead, which runs well. We replace all of this with measured numbers from KonaClaw's first-launch benchmark on your exact silicon the week we have them.</p>
  </section>
</Base>

<script>
  import {
    CHIPS, MODEL, WEIGHTS, NATIVE_CONTEXT_K,
    genRange, prefillRange, fitFor, maxGen, kvGB, needGB,
    genTokS, range, fmt, ctxLabel,
  } from "../lib/chips";

  const byName = new Map(CHIPS.map((c) => [c.name, c]));
  const rows = [...document.querySelectorAll<HTMLTableRowElement>("table.chip-table tbody tr[data-chip]")];

  function apply(ctxK: number) {
    const top = maxGen(ctxK);

    for (const tr of rows) {
      const c = byName.get(tr.dataset.chip!);
      if (!c) continue;

      const gen = genRange(c, ctxK);
      const bar = tr.querySelector<HTMLElement>(".speed .bar i");
      const num = tr.querySelector<HTMLElement>(".speed .num");
      if (bar) bar.style.width = Math.max(2, Math.round((gen[1] / top) * 100)) + "%";
      if (num) num.innerHTML = range(gen) + " <small>tk/s</small>";

      // Target the span, not the cell: the "est" marker sits beside it and
      // setting textContent on the whole <td> would wipe it.
      const pf = tr.querySelector<HTMLElement>(".prefill .pf-num");
      if (pf) pf.textContent = range(prefillRange(c, ctxK)) + "\u00a0tk/s";

      const fit = fitFor(c, ctxK);
      const el = tr.querySelector<HTMLElement>(".fit");
      if (el) {
        el.className = "fit " + fit.level;
        el.textContent = fit.label;
      }
      tr.classList.toggle("no-fit", fit.level === "no");
    }

    for (const s of document.querySelectorAll<HTMLElement>(".ctx-head")) {
      s.textContent = ctxLabel(ctxK);
    }

    const note = document.querySelector<HTMLElement>(".ctx-note");
    if (note) {
      const kv = kvGB(ctxK);
      const slower = Math.round((1 - genTokS(100, ctxK) / genTokS(100, 4)) * 100);
      const beyond = ctxK > NATIVE_CONTEXT_K
        ? ` That is past ${MODEL}'s native ${NATIVE_CONTEXT_K} K window, so it needs RoPE scaling and quality drifts.`
        : "";
      note.textContent =
        `At ${ctxLabel(ctxK)} the cache adds ${fmt(kv)} GB on top of the ~${WEIGHTS} GB of weights `
        + `— about ${fmt(needGB(ctxK))} GB in use. Generation runs ~${slower}% slower than a 4 K chat.`
        + beyond;
      note.hidden = ctxK === 4;
    }
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>(".ctx-btn")) {
    btn.addEventListener("click", () => {
      for (const b of document.querySelectorAll<HTMLButtonElement>(".ctx-btn")) {
        b.classList.toggle("is-active", b === btn);
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      }
      apply(Number(btn.dataset.ctx));
    });
  }
</script>
