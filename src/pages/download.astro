          <tr>
            <th scope="row">M3&nbsp;Ultra<span class="chip-meta">Studio</span></th>
            <td>24&ndash;28&nbsp;·&nbsp;60&ndash;80</td>
            <td>96&ndash;512&nbsp;GB</td>
            <td>819&nbsp;GB/s</td>
            <td class="prefill">~1&thinsp;500&nbsp;tk/s</td>
            <td><span class="speed"><span class="bar"><i style="width:82%"></i></span><span class="num">~90 <small>tk/s</small></span></span></td>
