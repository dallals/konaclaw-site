            <td>68&nbsp;GB/s</td>
            <td class="prefill">~130&nbsp;tk/s</td>
            <td><span class="speed"><span class="bar"><i style="width:7%"></i></span><span class="num">~8 <small>tk/s</small></span></span></td>
            <td><span class="fit no">No</span></td>
          </tr>
          <tr>
            <th scope="row">M1&nbsp;Pro<span class="chip-meta">14&Prime;/16&Prime; MBP · mini</span></th>
