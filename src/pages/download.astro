            <td><span class="fit tight">32&nbsp;GB</span></td>
          </tr>
          <tr>
            <th scope="row">M4&nbsp;Pro<span class="chip-meta">MBP · mini</span></th>
            <td>12&ndash;14&nbsp;·&nbsp;16&ndash;20</td>
