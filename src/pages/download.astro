            <td><span class="fit tight">24&ndash;32&nbsp;GB</span></td>
          </tr>
          <tr>
            <th scope="row">M1&nbsp;Max<span class="chip-meta">MBP · iMac</span></th>
            <td>8&ndash;10&nbsp;·&nbsp;24&ndash;32</td>
            <td>32&ndash;64&nbsp;GB</td>
            <td>410&nbsp;GB/s</td>
            <td class="prefill">~780&nbsp;tk/s</td>
